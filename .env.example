ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
DATABASE_URL=
DEBUG=0
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER=
EMAIL_PORT=
EMAIL_USE_TLS=
FRONTEND_URL=
FUNDING_DEMO_TOPUP_ENABLED=
LOG_LEVEL=
MARKET_USE_LIVE=
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_USER=
SECRET_KEY=
SECURE_HSTS_SECONDS=
# Real USDT TRC20 funding is fail-closed and requires explicit configuration.
FUNDING_DEPOSITS_ENABLED=0
NOWPAYMENTS_ENABLED=0
FUNDING_REQUIRE_KYC=1
FUNDING_LIVE_VERIFIED=0
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=
NOWPAYMENTS_PAYOUT_WALLET=
NOWPAYMENTS_SANDBOX=0
# Direct USDT TRC20 rail is the active crypto mode (keep disabled until
# operations verification). Use "nowpayments" only to restore the legacy rail.
CRYPTO_DEPOSIT_MODE=direct_tron
TRON_DEPOSITS_ENABLED=0
TRON_NETWORK=
# Must match TRON_NETWORK. TronGrid: https://api.trongrid.io (mainnet),
# https://nile.trongrid.io or https://api.shasta.trongrid.io (testnet).
TRON_API_BASE_URL=
TRON_API_KEY=
# One shared, public receiving wallet. Never put a private key or seed phrase
# in this file; the application never signs transactions.
VELTRIX_USDT_TRC20_RECEIVING_ADDRESS=
# Optional on mainnet (the official Tether TRC20 contract is pinned). Testnet
# requires an explicit test-token contract and must never reuse mainnet USDT.
TRON_USDT_CONTRACT=
TRON_REQUIRED_CONFIRMATIONS=0
# Mainnet credit attestation. Must remain 0 on testnet.
TRON_LIVE_VERIFIED=0
# Unique payable amounts are an optional matching aid, not proof of ownership.
TRON_UNIQUE_AMOUNT_ENABLED=0
TRON_AUTO_MATCH_UNIQUE_AMOUNT=0
TRON_AUTO_CREDIT_UNIQUE_AMOUNT=0
TRON_REQUEST_TTL_MINUTES=0
TRON_MIN_DEPOSIT=
TRON_MAX_DEPOSIT=
# Millisecond timestamp of the first event to scan. Required before the first
# direct scan; choose a conservative start and never move it backwards.
TRON_SCAN_START_TIMESTAMP=0
TRON_SCAN_WINDOW_SECONDS=3600
TRON_SCAN_OVERLAP_SECONDS=120
TRON_SCAN_LAG_SECONDS=60
TRON_HTTP_RETRIES=3
TRON_HTTP_BACKOFF_SECONDS=0.5
# Operational lease and alert thresholds for scheduled funding jobs.
TRON_JOB_LOCK_SECONDS=900
TRON_MONITOR_STALE_SECONDS=900
TRON_RECONCILE_STALE_SECONDS=93600
TRON_UNALLOCATED_ALERT_MINUTES=60
TRON_FAILURE_ALERT_THRESHOLD=3
# Detected transfers still short of the confirmation threshold move to manual
# review after this many minutes. Set 0 only if an operator monitors them.
TRON_UNCONFIRMED_REVIEW_MINUTES=1440
# Manual bank transfers: account details are provided by an operator outside
# the app. The currency must be configured and seeded before activation.
BANK_TRANSFERS_ENABLED=0
BANK_TRANSFER_CURRENCY=
