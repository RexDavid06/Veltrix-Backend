# ---------------------------------------------------------------------------
# VELTRIX backend environment template.
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit the real `.env`. In production, provide these values through your
# host's environment / secrets manager (no .env file is shipped).
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
# 1 = development, 0 = production
DEBUG=1
# Comma-separated hostnames, e.g. veltrix.example.com,www.veltrix.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database --------------------------------------------------------------
# Leave blank to use the bundled SQLite file (backend/instance/veltrix.db).
# Production example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Postgres service (consumed by docker-compose)
POSTGRES_USER=veltrix
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=veltrix

# --- CORS / frontend -------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Used to build links inside verification emails.
FRONTEND_URL=http://localhost:5173

# --- Market data -----------------------------------------------------------
# 1 = enable the live data feed, 0 = use illustrative sample prices.
MARKET_USE_LIVE=0

# --- Email -----------------------------------------------------------------
# Console backend prints mail to the terminal (dev). Use SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Real SMTP delivery example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@veltrix.local

# --- Security hardening (production only) ----------------------------------
# HSTS max-age in seconds (default 31536000 = 1 year).
SECURE_HSTS_SECONDS=31536000

# --- Logging ---------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
